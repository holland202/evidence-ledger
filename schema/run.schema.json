{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/holland202/evidence-ledger/schema/run.schema.json",
  "title": "Run",
  "description": "Metadata for an experimental execution, including sealed inputs and cost accounting. Token cost is never evidence of correctness.",
  "type": "object",
  "required": ["run_id"],
  "properties": {
    "schema_version": { "type": "string", "const": "0.1" },
    "run_id": { "type": "string" },
    "sealed": { "type": "boolean" },
    "input_hash": { "type": ["string", "null"] },
    "dataset_hash": { "type": ["string", "null"] },
    "prompt_hash": { "type": ["string", "null"] },
    "model_hash": { "type": ["string", "null"] },
    "environment_hash": { "type": ["string", "null"] },
    "seed": { "type": ["integer", "null"] },
    "model": { "type": ["string", "null"] },
    "model_version": { "type": ["string", "null"] },
    "temperature": { "type": ["number", "null"] },
    "input_tokens": { "type": ["integer", "null"] },
    "output_tokens": { "type": ["integer", "null"] },
    "reasoning_tokens": { "type": ["integer", "null"] },
    "tool_calls": { "type": ["integer", "null"] },
    "retry_count": { "type": ["integer", "null"] },
    "latency_ms": { "type": ["number", "null"] },
    "estimated_cost": { "type": ["number", "null"] },
    "human_in_loop": { "type": ["boolean", "null"] },
    "human_interventions": { "type": ["integer", "null"] },
    "automatic_retries": { "type": ["integer", "null"] },
    "operator_corrections": { "type": ["integer", "null"] },
    "timestamp": { "type": ["string", "null"], "format": "date-time" }
  },
  "additionalProperties": true
}
